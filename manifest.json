{
  "manifest_version": 3,
  "name": "Phish Guard",
  "version": "1.0.0",
  "description": "AI-powered phishing website detection: a Random Forest on URL features plus optional threat-intelligence checks, with a 0-100 risk score and reasons.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "notifications", "webNavigation", "activeTab"],
  "optional_host_permissions": ["https://dns.google/*", "https://rdap.org/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Phish Guard",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
